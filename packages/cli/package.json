{
  "name": "@copydoc/cli",
  "version": "0.1.0",
  "private": false,
  "description": "CLI for generating, critiquing, and adapting copy using copydoc copywriting skills",
  "author": "Steve Stomp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/srstomp/copyskills"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "copydoc": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/cli.ts --outdir dist --format esm --target bun",
    "test": "bun test",
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@copydoc/core": "workspace:*",
    "@google/generative-ai": "^0.24.1",
    "openai": "^6.33.0"
  }
}
