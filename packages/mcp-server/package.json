{
  "name": "@copydoc/mcp",
  "version": "0.1.0",
  "private": false,
  "description": "MCP server exposing copydoc copywriting skills, tools, and prompts to AI assistants",
  "author": "Steve Stomp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/srstomp/copyskills"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "copydoc-mcp": "dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --format esm --target bun",
    "test": "bun test",
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@copydoc/core": "workspace:*",
    "@modelcontextprotocol/sdk": "latest",
    "zod": "^4.3.6"
  }
}
