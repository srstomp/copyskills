{
  "name": "@copydoc/integrations",
  "version": "0.1.1",
  "type": "module",
  "private": false,
  "description": "Tool integration installer for copydoc copywriting skills (Cursor, Codex, and more)",
  "author": "Steve Stomp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/srstomp/copyskills"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "copydoc-integrations": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/cli.ts --outdir dist --format esm --target node --packages external && tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@copydoc/core": "^0.1.1"
  }
}
